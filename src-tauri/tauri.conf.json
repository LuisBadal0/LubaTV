{
  "productName": "Fred TV",
  "version": "1.9.1",
  "identifier": "dev.fredol.open-tv",
  "build": {
    "frontendDist": "../dist/open-tv/browser",
    "devUrl": "http://localhost:4200",
    "beforeDevCommand": "npm run start",
    "beforeBuildCommand": "ng build --configuration=production"
  },
  "app": {
    "windows": [
      {
        "title": "LubaTV (v1.9.1)",
        "width": 1100,
        "height": 720,
        "minWidth": 480,
        "minHeight": 400,
        "backgroundColor": "#0f0f14",
        "resizable": true,
        "fullscreen": false,
        "zoomHotkeysEnabled": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "wix": {
        "language": "en-US",
        "fragmentPaths": [
          "./windows/fragments/deps.wxs"
        ],
        "componentGroupRefs": [
          "DependencyComponents"
        ],
        "componentRefs": [
          "MpvComponent",
          "FfmpegComponent",
          "YtDlpComponent"
        ]
      }
    },
    "linux": {
      "deb": {
        "depends": [
          "mpv",
          "ffmpeg",
          "yt-dlp"
        ],
        "desktopTemplate": "linux/custom.desktop"
      },
      "rpm": {
        "depends": [
          "mpv",
          "ffmpeg",
          "yt-dlp"
        ],
        "desktopTemplate": "linux/custom.desktop"
      }
    }
  },
  "$schema": "../node_modules/@tauri-apps/cli/schema.json"
}
