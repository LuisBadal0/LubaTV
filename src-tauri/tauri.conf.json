{
  "productName": "LubaTV",
  "version": "1.0.0",
  "identifier": "dev.luisbadalo.lubatv",
  "build": {
    "frontendDist": "../dist/lubatv/browser",
    "devUrl": "http://localhost:4200",
    "beforeDevCommand": "npm run start",
    "beforeBuildCommand": "ng build --configuration=production"
  },
  "app": {
    "windows": [
      {
        "title": "LubaTV (v1.0.0)",
        "width": 1100,
        "height": 720,
        "minWidth": 480,
        "minHeight": 400,
        "backgroundColor": "#0f0f14",
        "resizable": true,
        "fullscreen": false,
        "zoomHotkeysEnabled": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "Luís Badalo",
    "copyright": "Copyright © 2026 Luís Badalo. Licensed under the GPL-2.0.",
    "category": "Video",
    "shortDescription": "A fast, keyboard-friendly IPTV player",
    "longDescription": "LubaTV plays IPTV from M3U files, M3U links and Xtream accounts, with live TV, movies and series, instant search, favorites, EPG, catch-up, recording and re-streaming.",
    "homepage": "https://github.com/LuisBadal0/LubaTV",
    "windows": {
      "wix": {
        "language": "en-US"
      }
    },
    "linux": {
      "deb": {
        "depends": [
          "mpv",
          "ffmpeg",
          "yt-dlp"
        ],
        "desktopTemplate": "linux/custom.desktop"
      },
      "rpm": {
        "depends": [
          "mpv",
          "ffmpeg",
          "yt-dlp"
        ],
        "desktopTemplate": "linux/custom.desktop"
      }
    }
  },
  "$schema": "../node_modules/@tauri-apps/cli/schema.json"
}
